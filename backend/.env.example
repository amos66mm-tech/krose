# 复制为 .env 并填入真实值；云端部署时改为在 Cursor Dashboard -> Secrets 中配置同名环境变量。

# --- Exa 搜索 API：https://exa.ai ---
EXA_API_KEY=

# --- LLM（遵循 OpenAI API 协议，可指向 OpenAI 官方或任意兼容供应商） ---
# 例如 DeepSeek: https://api.deepseek.com/v1  Moonshot: https://api.moonshot.cn/v1  本地 vLLM 等
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# --- 数据库（默认 SQLite，生产可换 Postgres：postgresql+psycopg://user:pass@host:5432/db） ---
DATABASE_URL=sqlite:///./data/giftradar.db

# --- 采集调度 ---
COLLECTION_INTERVAL_MINUTES=180
ENABLE_SCHEDULER=true
ALLOW_MOCK_FALLBACK=true
SEARCH_RESULTS_PER_WATCH=8

# --- CORS（多个来源用逗号分隔，本地开发用 * 即可） ---
CORS_ORIGINS=*

# --- 粗略汇率兜底（本地货币 / 1 USD） ---
# 当网页只给出「某面额卡对应多少本地货币」而没有直接给百分比时，用这个近似汇率换算成「占面值百分比」。
# 这不是实时汇率，仅供估算；建议定期手动更新，或后续接入实时汇率 API。
FX_NGN_PER_USD=1500
FX_GHS_PER_USD=15.5
FX_XAF_PER_USD=600
